		{
			"name": "5. Paiements croisés",
			"event": [
				{
					"listen": "test",
					"script": {
						"type": "text/javascript",
						"exec": [
							"pm.test('le virement Martin vers Durand est accepté', function () {",
							"    pm.response.to.have.status(201);",
							"    pm.expect(pm.response.json()).to.be.an('array').with.lengthOf(2);",
							"});",
							"",
							"const reverse = await pm.sendRequest({",
							"    url: pm.collectionVariables.get('baseUrl') + '/transfers',",
							"    method: 'POST',",
							"    header: {",
							"        'Content-Type': 'application/json',",
							"        'Idempotency-Key': '01970000-0000-7000-8000-000000000306',",
							"    },",
							"    body: {",
							"        mode: 'raw',",
							"        raw: JSON.stringify({",
							"            debtorWalletId: pm.collectionVariables.get('durandEurWallet'),",
							"            creditorWalletId: pm.collectionVariables.get('martinEurWallet'),",
							"            amount: '700',",
							"        }),",
							"    },",
							"});",
							"",
							"pm.test('le virement Durand vers Martin est accepté', function () {",
							"    pm.expect(reverse).to.have.property('code', 201);",
							"    const rows = reverse.json();",
							"    pm.expect(rows).to.be.an('array').with.lengthOf(2);",
							"    pm.expect(rows.map((row) => row.direction).sort()).to.eql(['CREDIT', 'DEBIT']);",
							"    pm.expect(rows.every((row) => row.amount === '700')).to.eql(true);",
							"});"
						]
					}
				}
			],
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "Content-Type",
						"value": "application/json"
					},
					{
						"key": "Idempotency-Key",
						"value": "01970000-0000-7000-8000-000000000305",
						"description": "UUID v7 identifiant la demande"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n  \"debtorWalletId\": \"{{martinEurWallet}}\",\n  \"creditorWalletId\": \"{{durandEurWallet}}\",\n  \"amount\": \"500\"\n}",
