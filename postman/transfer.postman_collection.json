		{
			"name": "7. Débit et crédit immuables",
			"event": [
				{
					"listen": "test",
					"script": {
						"type": "text/javascript",
						"exec": [
							"const created = pm.response.json();",
							"",
							"pm.test('le débit et le crédit ont le même montant', function () {",
							"    pm.response.to.have.status(201);",
							"    pm.expect(created).to.be.an('array').with.lengthOf(2);",
							"    const debit = created.find((row) => row.direction === 'DEBIT');",
							"    const credit = created.find((row) => row.direction === 'CREDIT');",
							"    pm.expect(debit.amount).to.eql('3300');",
							"    pm.expect(credit.amount).to.eql(debit.amount);",
							"    pm.expect(debit.idempotencyKeyId).to.eql('01970000-0000-7000-8000-000000000308');",
							"    pm.expect(credit.idempotencyKeyId).to.eql('01970000-0000-7000-8000-000000000308');",
							"});",
							"",
							"const baseUrl = pm.collectionVariables.get('baseUrl');",
							"const movementId = created[0].id;",
							"const patch = await pm.sendRequest({",
							"    url: baseUrl + '/transfers/' + movementId,",
							"    method: 'PATCH',",
							"    header: { 'Content-Type': 'application/json' },",
							"    body: { mode: 'raw', raw: JSON.stringify({ amount: '1' }) },",
							"});",
							"const remove = await pm.sendRequest({",
							"    url: baseUrl + '/transfers/' + movementId,",
							"    method: 'DELETE',",
							"});",
							"",
							"pm.test('un mouvement passé ne peut pas être modifié', function () {",
							"    pm.expect(patch).to.have.property('code', 404);",
							"});",
							"",
							"pm.test('un mouvement passé ne peut pas être supprimé', function () {",
							"    pm.expect(remove).to.have.property('code', 404);",
							"});"
						]
					}
				}
			],
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "Content-Type",
						"value": "application/json"
					},
					{
						"key": "Idempotency-Key",
						"value": "01970000-0000-7000-8000-000000000308",
						"description": "UUID v7 identifiant la demande"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n  \"debtorWalletId\": \"{{martinEurWallet}}\",\n  \"creditorWalletId\": \"{{durandEurWallet}}\",\n  \"amount\": \"3300\"\n}",
					"options": {
						"raw": {
							"language": "json"
						}
					}
				},
				"url": "{{baseUrl}}/transfers",
				"description": "Critère 7. La réponse expose le débit et le crédit du même montant. Le controller ne propose ni modification ni suppression : PATCH et DELETE sur le mouvement créé répondent 404."
			}
